  "userNodes": {
    "aeb136a9-2888-444d-8307-9445f4f65344": {
      "sourceCode": "// import input types generated by foxglove\nimport { Input, Message } from \"./types.ts\";\n// output is numbers\ntype Output = { sum: number; max: number; average: number };\n// input and output topic\nexport const inputs = [\"/power/thrusters/current\"];\nexport const output = \"/power/thrusters/current/stats\";\n// main function logic\nexport default function script(\n  event: Input<\"/power/thrusters/current\">,\n): Output {\n  let sum = 0;\n  let max = event.message.data[0];\n  for (let i = 0; i < event.message.data.length; i++) {\n    // skip thruster 6 for now since sensor is not perfect\n    if (i == 5) continue;\n    const v = event.message.data[i];\n    sum += v;\n    if (v > max) max = v;\n  }\n  let average = sum / (event.message.data.length - 1);\n  return { sum: sum, max: max, average: average };\n}\n",
      "name": "aeb136a9"
    }
  },
