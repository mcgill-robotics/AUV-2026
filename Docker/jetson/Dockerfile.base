# Stage 1: Base Image (Dockerfile.base)
# =============================================================================
# Build once, push to registry, treat as immutable artifact.
# Only rebuild intentionally when upgrading a dependency.
#
# Maps to: Isaac ROS 3.2 + JetPack 6.2 (L4T R36.4.3/R36.4.4)
# Tag date: 11/12/2025
# Do NOT upgrade JetPack without updating this tag.
# =============================================================================
ARG IMAGE_TAG=aarch64-ros2_humble_4c0c55dddd2bbcc3e8d5f9753bee634c
FROM nvcr.io/nvidia/isaac/ros:${IMAGE_TAG}

# ---- uv package manager ----
COPY --from=ghcr.io/astral-sh/uv:0.11.9 /uv /uvx /bin/

# ---- Build arguments ----
ARG OPENCV_VERSION=4.10.0
ARG JETSON_PIP_INDEX=https://pypi.jetson-ai-lab.io/jp6/cu126
ARG ZED_SDK_MAJOR=5
ARG ZED_SDK_MINOR=1
ARG ZED_SDK_PATCH=1
ARG L4T_MAJOR=36
ARG L4T_MINOR=4
ARG UBUNTU_RELEASE=22
ARG UBUNTU_MINOR_RELEASE=04

# ---- Environment ----
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive \
    UV_SYSTEM_PYTHON=1

# Standard Jetson CUDA paths
ENV CUDA_ROOT=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    CUDA_INC_DIR=/usr/local/cuda/include \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# Write L4T release info (needed by ZED SDK installer and other Jetson tools)
RUN echo "# R${L4T_MAJOR} (release), REVISION: ${L4T_MINOR}" > /etc/nv_tegra_release
RUN rm -f /etc/apt/sources.list.d/yarn.list
# =============================================================================
# 2. cuSPARSELt + cuDSS
# =============================================================================
WORKDIR /root

RUN CUSPARSE_LIBRARY_NAME="cusparselt-local-tegra-repo-ubuntu${UBUNTU_RELEASE}${UBUNTU_MINOR_RELEASE}-0.8.1_0.8.1-1_arm64.deb" && \
    wget https://developer.download.nvidia.com/compute/cusparselt/0.8.1/local_installers/${CUSPARSE_LIBRARY_NAME} && \
    dpkg -i ${CUSPARSE_LIBRARY_NAME} && \
    cp /var/cusparselt-local-tegra-repo-ubuntu${UBUNTU_RELEASE}${UBUNTU_MINOR_RELEASE}-0.8.1/cusparselt-*-keyring.gpg /usr/share/keyrings/ && \
    apt-get update && \
    apt-get -y install cusparselt-cuda-12 && \
    rm -rf ${CUSPARSE_LIBRARY_NAME} && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

ARG CUSPARSE_SOLVER_NAME="libcudss-linux-sbsa-0.6.0.5_cuda12-archive"
RUN mkdir -p tmp_cudss && cd tmp_cudss && \
    curl -L -O https://developer.download.nvidia.com/compute/cudss/redist/libcudss/linux-sbsa/${CUSPARSE_SOLVER_NAME}.tar.xz && \
    tar xf ${CUSPARSE_SOLVER_NAME}.tar.xz && \
    cp -a ${CUSPARSE_SOLVER_NAME}/include/* /usr/local/cuda/include/ && \
    cp -a ${CUSPARSE_SOLVER_NAME}/lib/* /usr/local/cuda/lib64/ && \
    rm -rf ${CUSPARSE_SOLVER_NAME} ${CUSPARSE_SOLVER_NAME}.tar.xz

# =============================================================================
# 3. System Build Tools & Prerequisites (Non-CUDA / Standard Tools)
# =============================================================================
# Installing basic development tools and prerequisites as its own mini-section
# to avoid overlapping with subsequent compilation dependencies.
# Also includes essential terminal utilities for developer debugging.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    curl \
    git \
    nano \
    python3-colcon-common-extensions \
    python3-rosdep \
    sudo \
    tar \
    tmux \
    vim \
    wget \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# 4. OpenCV CUDA Source Compilation + python_loader Wheel
# =============================================================================
# Compiles C++ headers/libs AND Python bindings from the same source tree.
# The python_loader wheel registers proper pip metadata so downstream
# ML frameworks see OpenCV as satisfied and don't overwrite it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gfortran \
    libatlas-base-dev \
    libavcodec-dev \
    libavformat-dev \
    libgtk-3-dev \
    libjpeg-dev \
    libpng-dev \
    libswscale-dev \
    libtiff-dev \
    libv4l-dev \
    python3-dev \
    python3-numpy && \
    git clone --depth 1 --branch ${OPENCV_VERSION} https://github.com/opencv/opencv.git /tmp/opencv && \
    git clone --depth 1 --branch ${OPENCV_VERSION} https://github.com/opencv/opencv_contrib.git /tmp/opencv_contrib && \
    mkdir /tmp/opencv/build && cd /tmp/opencv/build && \
    cmake -D CMAKE_BUILD_TYPE=Release \
          -D CMAKE_INSTALL_PREFIX=/usr/local \
          -D OPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib/modules \
          -D WITH_CUDA=ON \
          -D CUDA_ARCH_BIN=8.7 \
          -D WITH_CUDNN=OFF \
          -D OPENCV_DNN_CUDA=OFF \
          -D ENABLE_FAST_MATH=ON \
          -D CUDA_FAST_MATH=ON \
          -D BUILD_opencv_python3=ON \
          -D OPENCV_PYTHON3_INSTALL_PATH=lib/python3.10/dist-packages \
          -D PYTHON3_EXECUTABLE=$(which python3) \
          -D BUILD_JAVA=OFF \
          -D BUILD_opencv_java=OFF \
          -D BUILD_TESTS=OFF \
          -D BUILD_EXAMPLES=OFF \
          -D BUILD_opencv_sfm=OFF \
          -D OPENCV_GENERATE_PKGCONFIG=ON \
          .. && \
    make -j$(nproc) && \
    make install && ldconfig && \
    # OpenCV Metadata Mocks (prevents downstream frameworks from overwriting our custom OpenCV)
    for pkg in "opencv-python" "opencv-contrib-python" "opencv-python-headless"; do \
        TMP_DIR=$(mktemp -d) && \
        echo "from setuptools import setup; setup(name='$pkg', version='${OPENCV_VERSION}', packages=[])" > "$TMP_DIR/setup.py" && \
        uv pip install "$TMP_DIR" && \
        rm -rf "$TMP_DIR"; \
    done && \
    rm -rf /tmp/opencv /tmp/opencv_contrib && \
    rm -rf /var/lib/apt/lists/*

# Freeze specific OpenCV packages against APT overwrites
# Narrow hold to exact conflicting packages (avoid broad '*opencv*' wildcard)
# Note: These package names (specifically 'libopencv-core4.5d' and 'libopencv-imgproc4.5d')
# correspond to the default OpenCV versions in the base Ubuntu 22.04 (Jammy) OS distribution.
# If upgrading the underlying Ubuntu release of the base image (e.g. to Ubuntu 24.04 Noble),
# these held package names will need to be updated to match the new default package names in APT.
RUN apt-mark hold \
    libopencv-core-dev libopencv-core4.5d \
    libopencv-imgproc-dev libopencv-imgproc4.5d \
    libopencv-dev \
    python3-opencv 2>/dev/null || true

# =============================================================================
# 5. CV Bridge (vision_opencv) source build against custom CUDA OpenCV
# =============================================================================
# Building cv_bridge from source ensures it links against our custom 
# CUDA-accelerated OpenCV 4.10.0 instead of the CPU-only APT version.
WORKDIR /opt/ros/vision_opencv_ws
RUN git clone --depth 1 --branch humble https://github.com/ros-perception/vision_opencv.git src/vision_opencv && \
    . /opt/ros/humble/setup.sh && \
    colcon build --packages-select cv_bridge image_geometry \
    --merge-install \
    --cmake-args -DCMAKE_BUILD_TYPE=Release -DOpenCV_DIR=/usr/local/lib/cmake/opencv4 && \
    rm -rf build log src

# get constraints
COPY Docker/jetson/constraints.txt /tmp/

# =============================================================================
# 6. PyTorch (no version pins - Jetson AI Lab index prunes old versions)
# =============================================================================
# Install torch ecosystem from Jetson AI Lab with standard PyPI as fallback.
# After pushing this image, upstream wheel removal doesn't affect us.
RUN uv pip install --no-cache \
    --system \
    --reinstall \
    --index-url ${JETSON_PIP_INDEX} \
    -c /tmp/constraints.txt \
    torch torchvision torchaudio

# =============================================================================
# 7. ZED SDK + Python API
# =============================================================================
# Verify ZED SDK URL exists
ENV ZED_SDK_URL="https://download.stereolabs.com/zedsdk/${ZED_SDK_MAJOR}.${ZED_SDK_MINOR}.${ZED_SDK_PATCH}/l4t${L4T_MAJOR}.${L4T_MINOR}/jetsons"

RUN if [ "$(curl -L -I "${ZED_SDK_URL}" -o /dev/null -s -w '%{http_code}\n' | head -n 1)" = "200" ]; then \
        echo "ZED SDK URL is valid."; \
    else \
        echo "ZED SDK URL does not exist: ${ZED_SDK_URL}"; \
        exit 1; \
    fi

RUN cd /tmp && \
    wget -q --no-check-certificate -O ZED_SDK_installer.run ${ZED_SDK_URL} && \
    chmod +x ZED_SDK_installer.run && \
    ./ZED_SDK_installer.run silent skip_python skip_cuda && \
    chmod -R a+rX /usr/local/zed && \
    ldconfig && \
    rm -rf ZED_SDK_installer.run

# Install ZED Python API with --no-deps to prevent NumPy override.
RUN export PIP_INDEX_URL="https://pypi.python.org/simple" && \
    uv pip install --no-cache protobuf && \
    git clone -b v${ZED_SDK_MAJOR}.${ZED_SDK_MINOR}.${ZED_SDK_PATCH} \
        https://github.com/stereolabs/zed-python-api.git /tmp/zed-python-api && \
    uv pip install -v --no-deps --no-build-isolation /tmp/zed-python-api/src && \
    rm -rf /tmp/zed-python-api

WORKDIR /root
